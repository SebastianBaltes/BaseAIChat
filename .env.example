# Copy to .env and fill in. The key stays server-side – it never reaches the browser.

# google | openai | anthropic | openrouter
AI_PROVIDER=openrouter
AI_API_KEY=replace-me

# Where the proxy listens, and under which path it is mounted.
AI_PROXY_ADDR=:8090
AI_PROXY_PATH=/aichat

# Which models clients may request. Comma-separated, a trailing * is a wildcard.
# Leave empty to allow everything – but then a client can pick your priciest model.
AI_ALLOWED_MODELS=google/gemini-3-flash-preview,anthropic/claude-haiku-4.5

# Requests per minute per client. 0 disables the limit.
AI_RATE_LIMIT=60

# Only needed when the frontend runs on a different origin than the proxy.
# The example does not need it: Vite proxies /aichat, so it is same-origin.
# AI_CORS_ORIGIN=http://localhost:5180

# Frontend (example/.env.local)
# VITE_AI_PROVIDER=openrouter
# VITE_AI_MODEL=google/gemini-3-flash-preview
